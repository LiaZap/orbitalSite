# Copie para .env (local) ou cole nas Environment Variables do serviço no EasyPanel.
# NUNCA versione o .env preenchido.

# Postgres do EasyPanel — o painel do EasyPanel mostra a connection string interna
DATABASE_URL=postgres://postgres:SENHA@orbital_db:5432/orbital

# Senha do painel (/painel). Usuário pode ser qualquer coisa; só a senha é conferida.
PANEL_PASSWORD=troque-esta-senha

PORT=3000

# Só se o site estiver hospedado em outro domínio que não este servidor
# ALLOWED_ORIGIN=https://orbital.ag

# Postgres gerenciado externo que exige TLS
# PGSSL=true
